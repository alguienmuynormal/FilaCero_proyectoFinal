<Window x:Class="FilaCero.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FilaCero - Iniciar sesión" Height="560" Width="460"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource FondoLogin}">
    <Grid>
        <Border Background="White" CornerRadius="16" Padding="32,28"
                Width="360" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.35" Color="Black"/>
            </Border.Effect>
            <StackPanel>
                <Border Height="56" CornerRadius="14" Background="{StaticResource Navy}"
                        HorizontalAlignment="Center" Padding="14,0">
                    <Image Source="{StaticResource IconoFila}" Height="34" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="FilaCero" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Navy}"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="Inicia sesión para gestionar los turnos" FontSize="13"
                           Foreground="{StaticResource TextoSuave}" HorizontalAlignment="Center" Margin="0,2,0,24"/>

                <TextBlock Text="USUARIO" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtUsuario" Margin="0,0,0,14"/>

                <TextBlock Text="CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
                <PasswordBox x:Name="txtClave"/>

                <TextBlock x:Name="lblError" Foreground="{StaticResource Peligro}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,10,0,0"/>

                <Button x:Name="btnEntrar" Content="Entrar" IsDefault="True" Margin="0,16,0,0"
                        Style="{StaticResource BtnPrimario}" Click="btnEntrar_Click"/>
            </StackPanel>
        </Border>
        <TextBlock Text="Gestión de turnos virtuales" FontSize="11" Foreground="#99FFFFFF"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"/>
    </Grid>
</Window>
