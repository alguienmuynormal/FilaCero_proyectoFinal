<Application x:Class="FilaCero.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="LoginWindow.xaml">
    <Application.Resources>

        <!-- ===== PALETA ===== -->
        <SolidColorBrush x:Key="Navy" Color="#0F172A"/>
        <SolidColorBrush x:Key="Pizarra" Color="#1E293B"/>
        <SolidColorBrush x:Key="Acento" Color="#14B8A6"/>
        <SolidColorBrush x:Key="AcentoOscuro" Color="#0F766E"/>
        <SolidColorBrush x:Key="Fondo" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="Borde" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="TextoSuave" Color="#64748B"/>
        <SolidColorBrush x:Key="Exito" Color="#16A34A"/>
        <SolidColorBrush x:Key="Peligro" Color="#DC2626"/>

        <!-- Degradados y brillos de los botones -->
        <LinearGradientBrush x:Key="GradPrimario" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2DD4BF" Offset="0"/>
            <GradientStop Color="#0D9488" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GradPrimarioHover" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5EEAD4" Offset="0"/>
            <GradientStop Color="#14B8A6" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GradDestacado" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1E293B" Offset="0"/>
            <GradientStop Color="#0F172A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GradDestacadoHover" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F766E" Offset="0"/>
            <GradientStop Color="#134E4A" Offset="1"/>
        </LinearGradientBrush>
        <DropShadowEffect x:Key="BrilloPrimario" BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="#14B8A6"/>
        <DropShadowEffect x:Key="SombraBoton" BlurRadius="12" ShadowDepth="2" Opacity="0.20" Color="#0F172A"/>

        <!-- Degradado de fondo (login y cabecera) -->
        <LinearGradientBrush x:Key="FondoDegradado" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F172A" Offset="0"/>
            <GradientStop Color="#134E4A" Offset="0.6"/>
            <GradientStop Color="#14B8A6" Offset="1"/>
        </LinearGradientBrush>


        <!-- ===== FONDO DE PANTALLA: LOGIN (dibujado en vectores, no necesita imágenes) ===== -->
        <DrawingBrush x:Key="FondoLogin" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{StaticResource FondoDegradado}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,460,560"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#1AFFFFFF">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="430,30" RadiusX="170" RadiusY="170"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#12FFFFFF">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="20,540" RadiusX="200" RadiusY="200"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#0DFFFFFF">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="400,300" RadiusX="90" RadiusY="90"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#1AFFFFFF" Thickness="1.5"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="230,280" RadiusX="250" RadiusY="250"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#12FFFFFF" Thickness="1.5"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="230,280" RadiusX="330" RadiusY="330"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- ===== FONDO DE PANTALLA: VENTANA PRINCIPAL ===== -->
        <DrawingBrush x:Key="FondoPrincipal" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#F1F5F9">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,1000,680"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#1F14B8A6">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="940,640" RadiusX="260" RadiusY="260"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#140F172A">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="40,420" RadiusX="200" RadiusY="200"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#1214B8A6">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="620,230" RadiusX="120" RadiusY="120"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- ===== LOGO: UNA FILA DE PERSONAS (la primera, "fila cero", resaltada) ===== -->
        <DrawingImage x:Key="IconoFila">
            <DrawingImage.Drawing>
                <DrawingGroup>
                <GeometryDrawing Brush="#14B8A6">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="12,8" RadiusX="6.5" RadiusY="6.5"/>
                            <RectangleGeometry Rect="2,18,20,16" RadiusX="9" RadiusY="9"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#B3FFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="42,8" RadiusX="6.5" RadiusY="6.5"/>
                            <RectangleGeometry Rect="32,18,20,16" RadiusX="9" RadiusY="9"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#8CFFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="72,8" RadiusX="6.5" RadiusY="6.5"/>
                            <RectangleGeometry Rect="62,18,20,16" RadiusX="9" RadiusY="9"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#66FFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="102,8" RadiusX="6.5" RadiusY="6.5"/>
                            <RectangleGeometry Rect="92,18,20,16" RadiusX="9" RadiusY="9"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#40FFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="132,8" RadiusX="6.5" RadiusY="6.5"/>
                            <RectangleGeometry Rect="122,18,20,16" RadiusX="9" RadiusY="9"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- ===== TARJETAS Y CHIPS ===== -->
        <DropShadowEffect x:Key="SombraTarjeta" BlurRadius="18" ShadowDepth="2" Opacity="0.12" Color="#0F172A"/>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- ===== TEXTOS ===== -->
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- ===== CAJAS DE TEXTO ===== -->
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Acento}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Acento}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ===== BOTONES ===== -->

        <!-- Plantilla 1: botón principal (degradado + brillo + se eleva al pasar el mouse) -->
        <ControlTemplate x:Key="TplPrimario" TargetType="Button">
            <Border x:Name="bd" CornerRadius="10" Background="{StaticResource GradPrimario}"
                    Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{StaticResource GradPrimarioHover}"/>
                    <Setter TargetName="bd" Property="Effect" Value="{StaticResource BrilloPrimario}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-2" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="1" Duration="0:0:0.06"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-2" Duration="0:0:0.06"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Plantilla 2: botón "fantasma" (blanco con borde; al pasar el mouse se rellena con el color de su Tag) -->
        <ControlTemplate x:Key="TplFantasma" TargetType="Button">
            <Border x:Name="bd" CornerRadius="10" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                    <Setter TargetName="bd" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                    <Setter TargetName="bd" Property="Effect" Value="{StaticResource SombraBoton}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-2" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="1" Duration="0:0:0.06"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-2" Duration="0:0:0.06"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Plantilla 3: botón destacado (oscuro con halo que "late" mientras está habilitado) -->
        <ControlTemplate x:Key="TplDestacado" TargetType="Button">
            <Border x:Name="bd" CornerRadius="10" Background="{StaticResource GradDestacado}"
                    Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect x:Name="halo" BlurRadius="16" ShadowDepth="0" Opacity="0.2" Color="#14B8A6"/>
                </Border.Effect>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard x:Name="sbPulso">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="halo" Storyboard.TargetProperty="Opacity" From="0.15" To="0.75" Duration="0:0:1.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="sbPulso"/>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{StaticResource GradDestacadoHover}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-2" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Plantilla 4: botón de cabecera (translúcido sobre fondo oscuro) -->
        <ControlTemplate x:Key="TplCabecera" TargetType="Button">
            <Border x:Name="bd" CornerRadius="10" Background="#26FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#47FFFFFF"/>
                    <Setter TargetName="bd" Property="BorderBrush" Value="#80FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Icono vectorial para botones: toma el color del texto del botón -->
        <Style x:Key="Icono" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Estilos de botón -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Tag" Value="{StaticResource Pizarra}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template" Value="{StaticResource TplFantasma}"/>
        </Style>
        <Style x:Key="BtnPrimario" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Template" Value="{StaticResource TplPrimario}"/>
        </Style>
        <Style x:Key="BtnDestacado" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Template" Value="{StaticResource TplDestacado}"/>
        </Style>
        <Style x:Key="BtnCabecera" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template" Value="{StaticResource TplCabecera}"/>
        </Style>
        <Style x:Key="BtnExito" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Foreground" Value="#15803D"/>
            <Setter Property="BorderBrush" Value="#BBF7D0"/>
            <Setter Property="Tag" Value="{StaticResource Exito}"/>
        </Style>
        <Style x:Key="BtnPeligro" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="Tag" Value="{StaticResource Peligro}"/>
        </Style>
        <Style x:Key="BtnSecundario" TargetType="Button" BasedOn="{StaticResource BtnBase}"/>

        <!-- ===== TABLA ===== -->
        <Style x:Key="CeldaTexto" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0"/>
        </Style>
        <Style x:Key="CeldaEstado" TargetType="TextBlock" BasedOn="{StaticResource CeldaTexto}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding estado}" Value="Pendiente">
                    <Setter Property="Foreground" Value="#B45309"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding estado}" Value="Atendiendo">
                    <Setter Property="Foreground" Value="#0F766E"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Pastilla" TargetType="Border">
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="11,3"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="TextBlock.Foreground" Value="#475569"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding estado}" Value="Pendiente">
                    <Setter Property="Background" Value="#FEF3C7"/>
                    <Setter Property="TextBlock.Foreground" Value="#B45309"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding estado}" Value="Atendiendo">
                    <Setter Property="Background" Value="#CCFBF1"/>
                    <Setter Property="TextBlock.Foreground" Value="#0F766E"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EncabezadoTabla" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Pizarra}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="CeldaTabla" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CCFBF1"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>
